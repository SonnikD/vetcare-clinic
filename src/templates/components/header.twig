<header class="header"> 
    <div class="header__inner container">
        <a class="header__logo" href="index.html">
            <div class="header__logo-icon">
                {% include "components/icon.twig" with {
                    name: "logo"
                }  %}
            </div>
            <div class="header__logo-info">
                <span class="header__logo-text">VetCare</span>
                <span class="header__logo-subtitle">Ветклиника 24/7</span>
            </div>
        </a>
       
        <nav class="header__nav" id="main-nav" aria-label="Основная навигация">
            <ul class="header__nav-list">
                <li class="header__nav-item">
                    <a class="header__nav-link" href="services.html">Услуги</a>
                </li>
                <li class="header__nav-item">
                    <a class="header__nav-link" href="about.html">О клинике</a>
                </li>
                <li class="header__nav-item">
                    <a class="header__nav-link" href="doctors.html">Врачи</a>
                </li>
                <li class="header__nav-item">
                    <a class="header__nav-link" href="reviews.html">Отзывы</a>
                </li>
                <li class="header__nav-item">
                    <a class="header__nav-link" href="contacts.html">Контакты</a>
                </li>
            </ul>


            <div class="header__nav-actions">
                <div class="header__phone">
                    <div class="header__phone-icon">
                        {% include "components/icon.twig" with {name: "phone"} %}
                    </div>
                    <div class="header__phone-content">       
                        <span class="header__phone-label">Телефон</span>
                        <a class="header__phone-value" href="tel:+74951234567">+7 (495) 123-45-67</a>
                    </div>
                </div>
                {% include "components/button.twig" with {
                variant: "primary",
                text: "Записаться",
                href: "contacts.html#booking",
                icon: 'calendar',
                attrs: {"data-modal-open": "booking-modal"},
                large: true
            }  %}
            </div>
        </nav>
       
        <div class="header__actions">
            <a class="header__phone" href="tel:+74951234567">
                <div class="header__phone-icon">
                    {% include "components/icon.twig" with {
                        name: "phone"
                    }  %}
                </div>
                <span class="header__phone-text">+7 (495) 123-45-67</span>
            </a>
            {% include "components/button.twig" with {
                variant: "primary",
                text: "Записаться",
                href: "contacts.html#booking",
                icon: 'calendar',
                attrs: {"data-modal-open": "booking-modal"},
            }  %}
        </div>

        <button class="header__burger" aria-controls="main-nav" aria-expanded="false" type="button" aria-label="Меню"> 
            <span class="header__burger-line"></span>
            <span class="header__burger-line"></span>
            <span class="header__burger-line"></span>
        </button>
    
    </div>
</header>
