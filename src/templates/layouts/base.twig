<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="Современная ветеринарная клиника VetCare: бережный приём, УЗИ, вакцинация, стоматология и хирургия для кошек и собак. Работаем круглосуточно 24/7.">
        <title>{% block title %}Ветеринарная клиника{% endblock %} — VetCare</title>
        <link rel="icon" type="image/svg+xml" href="img/favicon.svg">
        <link rel="stylesheet" href="css/main.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Onest:wght@100..900&display=swap" rel="stylesheet">
    </head>
    <body>
        
        {% include "components/header.twig" %}
        
        <main>
            {% block page %}{% endblock %}
        </main>
        
        {% include "components/footer.twig" %}
        
        {% block modal %}
            {% embed "components/modal.twig" with { id: "booking-modal", label: "Запись на приём" } %}
                {% block content %}
                    {% include "components/booking.twig" %}
                {% endblock %}
            {% endembed %}
        {% endblock %}
        <script type="module" src="js/main.js"></script>
    </body>
</html>
