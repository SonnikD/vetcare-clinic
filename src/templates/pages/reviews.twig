{% block title %}Отзывы и вопросы{% endblock %}
{% block page %}
    <section class="reviews">
        <div class="container">
            {% include "components/section-heading.twig" with {
            label:"Отзывы владельцев",
            title: "Истории выздоровления и благодарности",
            description: "Мы ценим доверие каждого клиента и гордимся тем, что питомцы возвращаются к нам с радостью и без страха."
        }  %}

            <div class="reviews__cards">
                {% for review in reviews %}
                    {% include "components/review-card.twig" with review %}
                {% endfor %}
            </div>
        </div>




    </section>
{% endblock %}
