{% block title %}Услуги ветеринарной клиники{% endblock %}
{% block page %}
    <section class="services">
        <div class="container">
            {% include "components/section-heading.twig" with {
            label:"Каталог услуг",
            title: "Какие ветеринарные услуги мы оказываем?",
            description: "Клиника VetCare предоставляет полный комплекс медицинских и профилактических услуг для домашних животных: от первичного терапевтического осмотра и плановой вакцинации до ультразвуковой диагностики экспертного класса, бережной стоматологии и малоинвазивной хирургии в условиях круглосуточного стационара."
        }  %}

            <div class="services__tags">
                {% set tags = ["Все услуги"] %}

                {% for service in services %}
                    {% if service.tag not in tags %}
                        {% set tags = tags|merge([service.tag]) %}
                    {% endif %}
                {% endfor %}

                {% for tag in tags %}
                    {% include "components/tag.twig" with {
                        text: tag, active: loop.first, attrs: {'data-filter': tag}
                    }  %} 
                {% endfor %}
            </div>



            <div class="services__cards">
                {% for service in services %}
                    {% include "components/service-card.twig" with service|merge({ index: loop.index, attrs: {'data-tag': service.tag} }) %}
                {% endfor %}
            </div>
            {% include "components/cta-block.twig" with {
                title: 'Не нашли нужную процедуру?', 
                description: 'Позвоните нам или оставьте заявку — дежурный врач проконсультирует по симптомам и сориентирует по стоимости.',
                button: 'Получить консультацию'
            } %}
        </div>
    </section>

{% endblock %}

{% block modal %}
    {{ parent() }} 

    {% for service in services %}
        {% embed "components/modal.twig" with { id: "service-modal-" ~ loop.index, label: service.title } %}
            {% block content %}
                {% include "components/service-details.twig" with service %}
            {% endblock %}
        {% endembed %}

    {% endfor %}
{% endblock %}
    

